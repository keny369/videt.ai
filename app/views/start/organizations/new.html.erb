<% content_for :title, "Name your organization" %>

<div class="panel">
  <h1>Name your organization</h1>
  <p class="lede">
    Step 2 of 2, for <strong><%= @email %></strong>. This creates the organization, its
    billing entity, your administrator role and a first draft project in one commit.
  </p>

  <% if @error.present? %>
    <div class="errors" role="alert" tabindex="-1">
      <h2>That could not be completed</h2>
      <p><%= @error %></p>
    </div>
  <% end %>

  <% if @field_errors.present? %>
    <div class="errors" role="alert" tabindex="-1">
      <h2>Check the following</h2>
      <ul>
        <% @field_errors.each do |field, message| %>
          <li><%= link_to message, "##{field}" %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: start_bootstrap_organization_path, method: :post, data: { turbo: false }, class: "form" do %>
    <div class="field">
      <%= label_tag :organization_display_name, "Organization name" %>
      <%= text_field_tag :organization_display_name, @organization_display_name, required: true,
                         maxlength: 120, autofocus: true,
                         "aria-invalid": @field_errors&.key?(:organization_display_name),
                         "aria-describedby": "organization_display_name_hint" %>
      <p class="hint" id="organization_display_name_hint">1 to 120 characters.</p>
    </div>

    <div class="field">
      <%= label_tag :project_display_name, "First project name" %>
      <%= text_field_tag :project_display_name, @project_display_name, required: true,
                         maxlength: 120,
                         "aria-invalid": @field_errors&.key?(:project_display_name),
                         "aria-describedby": "project_display_name_hint" %>
      <p class="hint" id="project_display_name_hint">
        The website or property you want assessed first.
      </p>
    </div>

    <div class="field">
      <%= label_tag :local_presence_reason, "Why this project has no local presence" %>
      <%= text_area_tag :local_presence_reason, @local_presence_reason, required: true,
                        minlength: Workflows::Wf002::ProjectCreation::REASON_MIN,
                        maxlength: Workflows::Wf002::ProjectCreation::REASON_MAX, rows: 3,
                        "aria-invalid": @field_errors&.key?(:local_presence_reason),
                        "aria-describedby": "local_presence_reason_hint" %>
      <p class="hint" id="local_presence_reason_hint">
        Local presence is assessed only for businesses customers reach at a place, so we
        need your own statement of why this one is not. For example: online-only trader,
        or a fully remote service business with no premises customers visit.
        <%= Workflows::Wf002::ProjectCreation::REASON_MIN %> to
        <%= Workflows::Wf002::ProjectCreation::REASON_MAX %> characters.
      </p>
    </div>

    <button type="submit">Create organization</button>
  <% end %>
</div>
