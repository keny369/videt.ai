<% content_for :title, "Create an organization" %>

<div class="panel">
  <h1>Create an organization</h1>
  <p class="lede">
    Step 1 of 2. Confirm the email address that will hold the first administrator account.
  </p>

  <% if @error.present? %>
    <div class="errors" role="alert" tabindex="-1">
      <h2>That could not be completed</h2>
      <p><%= @error %></p>
    </div>
  <% end %>

  <%# data-turbo="false": a receipt-entry form under /start submits with Accept: text/html
      and receives a 303 to its logical destination (FRONTEND_ARCHITECTURE.md :158). %>
  <%= form_with url: start_bootstrap_grant_path, method: :post, data: { turbo: false }, class: "form" do %>
    <div class="field">
      <%= label_tag :email, "Email address" %>
      <%= email_field_tag :email, @email, required: true, autocomplete: "email",
                          autofocus: true, "aria-invalid": @error.present? %>
    </div>

    <button type="submit">Continue</button>
  <% end %>

  <p class="aside">
    Already have an organization? <%= link_to "Sign in", start_sign_in_path %>.
  </p>
</div>
