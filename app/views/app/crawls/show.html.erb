<% content_for :title, "Crawl" %>

<nav aria-label="Breadcrumb" class="breadcrumb">
  <%= link_to "Projects", app_projects_path %> &rsaquo;
  <%= link_to @project["display_name"], app_project_sources_path(@project["id"]) %> &rsaquo;
  <%= link_to "Crawls", app_project_crawls_path(@project["id"]) %> &rsaquo;
  <span aria-current="page">This run</span>
</nav>

<div class="page-heading">
  <h1>Crawl</h1>
  <div class="actions">
    <span class="state state--<%= @crawl["state"] %>"><%= @crawl["state"] %></span>
  </div>
</div>

<dl class="facts">
  <dt>Queued</dt>
  <dd><%= (@crawl["queued_at"] || @crawl["created_at"]).to_s.first(19) %></dd>
  <dt>Started</dt>
  <dd><%= @crawl["started_at"].to_s.first(19).presence || "not yet" %></dd>
  <dt>Finished</dt>
  <dd><%= @crawl["terminal_at"].to_s.first(19).presence || "not yet" %></dd>
  <dt>Kind</dt>
  <dd><%= @crawl["kind"] %> (<%= @crawl["trigger_kind"] %>)</dd>
  <% if @crawl["completion_reason"].present? %>
    <dt>Outcome</dt>
    <dd><%= @crawl["completion_reason"] %></dd>
  <% end %>
  <% if @crawl["coverage_status"].present? %>
    <dt>Coverage</dt>
    <dd><%= @crawl["coverage_status"] %></dd>
  <% end %>
</dl>

<%# A run that is not terminal has nothing to explain yet, and saying "no documents" of a
    run that has not finished would be a false negative rather than an empty result. %>
<% if %w[queued running].include?(@crawl["state"]) %>
  <p class="aside">
    This run has not finished. State advances in the background;
    <%= link_to "reload", app_project_crawl_path(@project["id"], @crawl["id"]) %> to see where it is.
  </p>
<% end %>

<h2>Evaluation</h2>
<%# The Evaluation a started Crawl opens. It is on this screen because its state is what
    decides whether the project can be crawled again, so a reader who wants to know "why
    can I not crawl" finds the answer next to the run that caused it. %>
<% if @evaluation.nil? %>
  <p class="empty">
    This run opened no evaluation. Only a crawl that started opens one.
  </p>
<% else %>
  <dl class="facts">
    <dt>State</dt>
    <dd><span class="state state--<%= @evaluation["state"] %>"><%= @evaluation["state"] %></span></dd>
    <dt>Resolved</dt>
    <dd><%= (@evaluation["completed_at"] || @evaluation["failed_at"]).to_s.first(19).presence || "not yet" %></dd>
    <% if @evaluation["reason"].present? %>
      <dt>Reason</dt>
      <dd><%= @evaluation["reason"] %></dd>
    <% end %>
  </dl>
  <% if (explanation = App::Crawls::EVALUATION_REASONS[@evaluation["reason"]]) %>
    <p class="hint"><%= explanation %></p>
  <% end %>
  <% if @evaluation["readiness_status"].present? %>
    <dl class="facts">
      <dt>Inputs</dt>
      <dd><%= @evaluation["readiness_status"] %> (<%= @evaluation["successful_count"] %> parsed,
          <%= @evaluation["failed_count"] %> failed)</dd>
    </dl>
  <% end %>
  <% if %w[pending running].include?(@evaluation["state"]) %>
    <p class="aside">
      <%# The two reasons an evaluation is unresolved are different things, and telling them
          apart is the difference between "your crawl gave us nothing" and "the checks are
          still running". %>
      <% if @evaluation["readiness_status"].to_s.start_with?("ready") %>
        This crawl's content is parsed and its checks are running. While the evaluation is
        unresolved the project accepts no further crawls.
      <% else %>
        While this evaluation is unresolved the project accepts no further crawls.
      <% end %>
    </p>
  <% end %>
<% end %>

<%# ============================================================================ findings %>
<% if @check_results.any? %>
  <h2>Checks</h2>

  <%# THE SCORE IS SHOWN AS UNAVAILABLE, NOT AS AN ERROR. Under the ratified baseline the
      four measurement checks have no measurement set to read, so their pillars have
      insufficient evidence and no overall number can be supported. Saying that plainly is
      the honest screen; showing a zero, or a red failure, would be a fabricated number and a
      false accusation respectively. %>
  <div class="score-summary">
    <p class="score-value">Overall score: <strong>unavailable</strong></p>
    <p class="hint"><%= score_unavailable_sentence(@check_results) %></p>
  </div>

  <p class="aside">
    <%= @check_results.length %> of <%= @applicability ? @applicability["entry_count"] : @check_results.length %>
    expected checks ran, from catalogue
    <%= @applicability ? @applicability["check_catalog_version"] : "check-catalog-v1" %>.
  </p>

  <table class="collection">
    <caption class="visually-hidden">Every check this evaluation ran, and what it decided</caption>
    <thead>
      <tr>
        <th scope="col">Check</th>
        <th scope="col">Observed</th>
        <th scope="col">Result</th>
        <th scope="col">Impact</th>
      </tr>
    </thead>
    <tbody>
      <%# One row per check, worst first. A per-page check runs once per Document, and one row
          per Result would be a 226-row table that buries the single page that failed. %>
      <% check_groups(@check_results).each do |group| %>
        <% result = group.worst %>
        <tr class="check check--<%= result["execution_status"] %>">
          <th scope="row">
            <%= check_name(group.definition_id) %>
            <span class="muted"><%= group.definition_id %> &middot; <%= pillar_name(group.pillar_id) %><%=
              " · #{group.count} pages" if group.count > 1 %></span>
            <% if (reason = why_it_matters(group.definition_id)) %>
              <p class="hint"><%= reason %></p>
            <% end %>
          </th>
          <td>
            <%= group_observed(group) %>
            <%# The failing subjects, named. A tally alone tells a reader something is wrong
                without telling them where. %>
            <% if group.failures.any? && group.count > 1 %>
              <ul class="subjects">
                <% group.failures.first(10).each do |failure| %>
                  <li><%= finding_subject(failure) %> &mdash; <%= failure["outcome_code"] %></li>
                <% end %>
              </ul>
              <% if group.failures.length > 10 %>
                <p class="hint"><%= group.failures.length - 10 %> more.</p>
              <% end %>
            <% end %>
            <% if (items = measured_items(result)).any? %>
              <p class="hint">
                Not found for:
                <%= items.first(5).map { |i| i.is_a?(Hash) ? i.values.first : i }.join(", ") %><%= "…" if items.length > 5 %>
              </p>
            <% end %>
          </td>
          <td>
            <span class="state state--check-<%= result["execution_status"] %>">
              <%= freshness_label(result) || finding_status_label(result["execution_status"]) %>
            </span>
            <% if result["execution_status"] == "error" %>
              <p class="hint"><%= not_measured_reason(result["error_reason_code"]) %></p>
            <% elsif result["execution_status"] == "not_applicable" %>
              <p class="hint">
                This project has recorded that local presence does not apply to it, so this
                check was not run and counts neither for nor against it.
              </p>
            <% else %>
              <span class="muted"><%= result["outcome_code"] %></span>
            <% end %>
          </td>
          <td><%= result["impact_band"].presence || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <h2>Findings</h2>
  <% if @issues.empty? %>
    <p class="empty">
      No findings. Every check that could be measured was met.
    </p>
  <% else %>
    <p class="aside">
      <%= @issues.length %> <%= "finding".pluralize(@issues.length) %> from this evaluation.
      <% if @issue_set %>
        The finding set was sealed with <%= @issue_set["member_count"] %>
        <%= "member".pluralize(@issue_set["member_count"].to_i) %>.
      <% end %>
    </p>
    <table class="collection">
      <caption class="visually-hidden">Findings this evaluation produced</caption>
      <thead>
        <tr>
          <th scope="col">Finding</th>
          <th scope="col">Applies to</th>
          <th scope="col">Impact</th>
          <th scope="col">Effort</th>
          <th scope="col">Status</th>
        </tr>
      </thead>
      <tbody>
        <% @issues.each do |issue| %>
          <tr class="issue issue--<%= issue["impact_band"] %>">
            <th scope="row">
              <%= issue["issue_type"].tr("_", " ").capitalize %>
              <span class="muted"><%= check_name(issue["check_definition_id"]) %></span>
            </th>
            <td><%= finding_subject(issue) %></td>
            <td><span class="impact impact--<%= issue["impact_band"] %>"><%= issue["impact_band"] %></span></td>
            <td><%= issue["effort_band"].presence || "—" %></td>
            <td>
              <%# A withheld candidate is NOT a published finding, and the screen says which
                  it is. Under the ratified baseline every finding carries valid high
                  confidence and publishes, so a withheld one here would be a real signal. %>
              <%= issue["publication_status"] == "published" ? "Open" : "Held for review" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% elsif @evaluation && @evaluation["state"] == "running" %>
  <h2>Checks</h2>
  <p class="empty">
    The checks for this evaluation are running.
    <%= link_to "Reload", app_project_crawl_path(@project["id"], @crawl["id"]) %> to see them.
  </p>
<% end %>

<h2>Sources</h2>
<% if @sources.empty? %>
  <p class="empty">This run was pinned to no sources.</p>
<% else %>
  <table class="collection">
    <caption class="visually-hidden">Sources this crawl was pinned to</caption>
    <thead>
      <tr>
        <th scope="col">Address</th>
        <th scope="col">Scope policy</th>
      </tr>
    </thead>
    <tbody>
      <% @sources.each do |source| %>
        <tr>
          <th scope="row"><%= source["canonical_root_uri"] %></th>
          <td><%= source["scope_policy_version"] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<h2>Documents</h2>
<% if @documents.empty? %>
  <p class="empty">
    This run produced no documents.
    <% if @terminal_outcomes.any? %>
      The per-URL outcomes below say why.
    <% end %>
  </p>
<% else %>
  <table class="collection">
    <caption class="visually-hidden">Documents this crawl produced</caption>
    <thead>
      <tr>
        <th scope="col">URL</th>
        <th scope="col">Version</th>
        <th scope="col">Type</th>
        <th scope="col">Bytes</th>
        <th scope="col">State</th>
      </tr>
    </thead>
    <tbody>
      <% @documents.each do |document| %>
        <tr>
          <th scope="row"><%= document["canonical_url"] %></th>
          <td><%= document["version"] %></td>
          <td><%= document["media_type"] || "—" %></td>
          <td><%= document["byte_size"] %></td>
          <td><span class="state state--<%= document["state"] %>"><%= document["state"] %></span></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<h2>URL outcomes</h2>
<% if @terminal_outcomes.empty? %>
  <p class="empty">No URL has reached a terminal outcome in this run.</p>
<% else %>
  <table class="collection">
    <caption class="visually-hidden">Per-URL terminal outcomes</caption>
    <thead>
      <tr>
        <th scope="col">#</th>
        <th scope="col">Outcome</th>
        <th scope="col">Reason</th>
        <th scope="col">Coverage</th>
        <th scope="col">Bytes</th>
      </tr>
    </thead>
    <tbody>
      <% @terminal_outcomes.each do |row| %>
        <tr>
          <th scope="row"><%= row["commit_order"] %></th>
          <td><%= row["outcome"] %></td>
          <td><%= row["reason"] || "—" %></td>
          <td><%= row["coverage_effect"] %></td>
          <td><%= row["accounted_response_body_bytes"] || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<h2>Fetches</h2>
<% if @fetch_attempts.empty? %>
  <p class="empty">
    No fetch was attempted. A run that cannot get its robots.txt terminates before
    requesting anything else.
  </p>
<% else %>
  <table class="collection">
    <caption class="visually-hidden">Fetch attempts this crawl made</caption>
    <thead>
      <tr>
        <th scope="col">URL</th>
        <th scope="col">Kind</th>
        <th scope="col">#</th>
        <th scope="col">Outcome</th>
        <th scope="col">Reason</th>
        <th scope="col">Status</th>
        <th scope="col">Bytes</th>
        <th scope="col">ms</th>
      </tr>
    </thead>
    <tbody>
      <% @fetch_attempts.each do |attempt| %>
        <tr>
          <th scope="row"><%= attempt["canonical_url"] %></th>
          <td><%= attempt["request_kind"] %></td>
          <td><%= attempt["attempt_number"] %></td>
          <td><%= attempt["outcome"] || "in progress" %></td>
          <td><%= attempt["reason_code"] || "—" %></td>
          <td><%= attempt["http_status"] || "—" %></td>
          <td><%= attempt["accounted_response_bytes"] || "—" %></td>
          <td><%= attempt["latency_ms"] || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<p class="aside">
  <%= link_to "Back to crawls", app_project_crawls_path(@project["id"]) %>
</p>
