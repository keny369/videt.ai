<% content_for :title, "Register a source" %>

<h1>Register a source</h1>
<p class="lede">
  Registering proposes a source. It is not crawled until ownership is verified and the
  source is activated.
</p>

<% if @error.present? %>
  <div class="errors" role="alert" tabindex="-1">
    <h2>That could not be registered</h2>
    <p><%= @error %></p>
  </div>
<% end %>

<%= form_with url: app_project_sources_path(@project_id), method: :post,
              data: { turbo: false }, class: "form" do %>
  <div class="field">
    <%= label_tag :submitted_root_uri, "Root address" %>
    <%= text_field_tag :submitted_root_uri, @submitted_root_uri, required: true,
                       autofocus: true, inputmode: "url", placeholder: "https://example.com",
                       "aria-invalid": @error.present?,
                       "aria-describedby": "submitted_root_uri_hint" %>
    <p class="hint" id="submitted_root_uri_hint">
      An absolute HTTPS address. The host is normalized and must be unique within the project.
    </p>
  </div>

  <button type="submit">Register source</button>
  <%= link_to "Cancel", app_project_sources_path(@project_id), class: "button button--quiet" %>
<% end %>
