<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "F1" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body>
    <%# FRONTEND_ARCHITECTURE.md :104 — the skip link is the first focusable element. %>
    <a class="skip-link" href="#main">Skip to main content</a>

    <%# :107 one aria-live region for status. Polite: a flash is never urgent enough to
        interrupt a screen reader mid-sentence. %>
    <div class="flashes" role="status" aria-live="polite">
      <% if flash[:notice].present? %>
        <p class="flash flash--notice"><%= flash[:notice] %></p>
      <% end %>
      <% if flash[:alert].present? %>
        <p class="flash flash--alert"><%= flash[:alert] %></p>
      <% end %>
    </div>

    <%= yield :shell %>

    <main id="main">
      <%= yield %>
    </main>
  </body>
</html>
