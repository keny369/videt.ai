#!/usr/bin/env bash
# DEPRECATED BY ADR-129. Use bin/f1-db-bootstrap.
#
# WHAT THIS SCRIPT USED TO CLAIM AND WHY IT WAS WRONG. Its header began "Authoritative, reproducible
# database provisioning from a genuinely empty state" and step [3/5] was "run migrations", and its
# final line printed "provisioned '$DB' ($ENV) from empty". None of that described what happened.
# `bin/f1db db:migrate` against an empty database calls Rails' `initialize_database`, which sees no
# `schema_migrations` table and LOADS `db/structure.sql` — whose recorded versions cover all 70
# migrations — so the migration run that followed executed ZERO migrations, every time, in every
# provisioning run this repository has ever performed. It also rewrote `db/structure.sql` in the
# working tree, because `db:migrate` invokes `db:_dump`.
#
# This wrapper now delegates to the route that says what it does and proves each step.
set -euo pipefail
cd "$(dirname "$0")/.."
echo "bin/f1-provision-db is DEPRECATED (ADR-129): it described a migration build it never performed."
echo "Delegating to bin/f1-db-bootstrap, which loads the immutable baseline and then executes every"
echo "post-baseline migration, and which states the operation it actually performed."
echo
exec ./bin/f1-db-bootstrap "$@"
